{
  "name": "flow-recorder",
  "displayName": "Flow Recorder",
  "description": "Record Maestro mobile tests by tapping a mirrored Android device or iOS Simulator, straight from your editor.",
  "version": "0.1.0",
  "publisher": "podupu",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "flowRecorder.flowEditor",
        "displayName": "Flow Recorder",
        "selector": [
          {
            "filenamePattern": "*.flow.yaml"
          },
          {
            "filenamePattern": "*.flow.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "flowRecorder.startMirror",
        "title": "Start Device Mirror",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.diagnoseSelectors",
        "title": "Diagnose Broken Selectors",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.addApiBlock",
        "title": "Add API Block",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.addScreenshotBlock",
        "title": "Add Screenshot Block",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.openBlockView",
        "title": "Open Visual Block View",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.selectEnvironment",
        "title": "Select Environment",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.selectPlatform",
        "title": "Select Platform",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.editEnvironments",
        "title": "Edit Environments",
        "category": "Flow Recorder"
      },
      {
        "command": "flowRecorder.showFlowDiagnostics",
        "title": "Show Flow Detection Diagnostics",
        "category": "Flow Recorder"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "flowRecorder.addApiBlock",
          "when": "flowRecorder.isFlowFile",
          "group": "flowRecorder@1"
        },
        {
          "command": "flowRecorder.diagnoseSelectors",
          "when": "flowRecorder.isFlowFile",
          "group": "flowRecorder@1"
        },
        {
          "command": "flowRecorder.addScreenshotBlock",
          "when": "flowRecorder.isFlowFile",
          "group": "flowRecorder@2"
        },
        {
          "command": "flowRecorder.startMirror",
          "when": "flowRecorder.isFlowFile",
          "group": "flowRecorder@3"
        },
        {
          "command": "flowRecorder.openBlockView",
          "when": "flowRecorder.isFlowFile",
          "group": "flowRecorder@4"
        }
      ],
      "commandPalette": [
        {
          "command": "flowRecorder.addApiBlock",
          "when": "flowRecorder.isFlowFile"
        },
        {
          "command": "flowRecorder.addScreenshotBlock",
          "when": "flowRecorder.isFlowFile"
        },
        {
          "command": "flowRecorder.openBlockView",
          "when": "flowRecorder.isFlowFile"
        },
        {
          "command": "flowRecorder.diagnoseSelectors",
          "when": "flowRecorder.isFlowFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "flowRecorder.selectEnvironment",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && flowRecorder.isFlowFile"
      }
    ],
    "configuration": {
      "title": "Flow Recorder",
      "properties": {
        "flowRecorder.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage counts (mirror opened, step recorded, flow run) to help prioritise development. No file contents, selectors, device ids or paths are ever sent. Also requires VS Code telemetry to be enabled."
        },
        "flowRecorder.flowPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.flow.yaml",
            "**/*.flow.yml",
            "**/.maestro/**/*.yaml",
            "**/.maestro/**/*.yml"
          ],
          "description": "Globs identifying Maestro flow files. Defaults to the Maestro convention. Set this if your project keeps flows elsewhere, e.g. [\"e2e-tests/**/*.yaml\"]. Matching every *.yaml is not recommended - unrelated files would gain Flow Recorder commands and appear in the Testing view."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && mocha test/unit/*.test.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#12303B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/podupu/flow-recorder.git"
  },
  "homepage": "https://github.com/podupu/flow-recorder#readme",
  "bugs": {
    "url": "https://github.com/podupu/flow-recorder/issues"
  },
  "keywords": [
    "maestro",
    "mobile testing",
    "e2e",
    "android",
    "ios",
    "appium alternative",
    "test recorder",
    "emulator",
    "simulator",
    "yaml"
  ]
}
